generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model AdminUser {
  id               String             @id @default(cuid())
  email            String             @unique
  name             String
  password         String
  role             AdminRole          @default(ADMIN)
  isActive         Boolean            @default(true)
  lastLogin        DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  auditLogs        AdminAuditLog[]
  availability     AdminAvailability?
  aiConversations  AiConversation[]
  liveChatSessions LiveChatSession[]
  assignedTickets  SupportTicket[]

  @@map("admin_users")
}

model AdminAuditLog {
  id          String        @id @default(cuid())
  adminId     String
  adminEmail  String
  adminName   String
  action      AuditAction
  category    AuditCategory
  targetId    String?
  targetType  String?
  targetLabel String?
  description String
  changes     String?
  metadata    String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime      @default(now())
  admin       AdminUser     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([action])
  @@index([category])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("categories")
}

model Product {
  id                       String                    @id @default(cuid())
  name                     String
  description              String?
  slug                     String                    @unique
  price                    Float
  compareAtPrice           Float?
  categoryId               String?
  images                   String
  materials                String?
  careGuide                String?
  isLimitedEdition         Boolean                   @default(false)
  releaseDate              DateTime?
  dropEndDate              DateTime?
  maxQuantity              Int?
  isActive                 Boolean                   @default(true)
  isFeatured               Boolean                   @default(false)
  isFeaturedNewArrival     Boolean                   @default(false)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  costPrice                Float?
  avatarItems              AvatarItem[]
  backInStockNotifications BackInStockNotification[]
  cartItems                CartItem[]
  cartReservations         CartReservation[]
  collections              CollectionProduct[]
  dropNotifications        DropNotification[]
  orderItems               OrderItem[]
  sourceRecommendations    ProductRecommendation[]   @relation("SourceProduct")
  targetRecommendations    ProductRecommendation[]   @relation("TargetProduct")
  variants                 ProductVariant[]
  productViews             ProductView[]
  category                 Category?                 @relation(fields: [categoryId], references: [id])
  reviews                  Review[]
  wishlistItems            WishlistItem[]

  @@map("products")
}

model Collection {
  id          String              @id @default(cuid())
  name        String              @unique
  slug        String              @unique
  description String?
  image       String?
  isActive    Boolean             @default(true)
  isFeatured  Boolean             @default(false)
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  products    CollectionProduct[]

  @@map("collections")
}

model CollectionProduct {
  id           String     @id @default(cuid())
  collectionId String
  productId    String
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
  @@map("collection_products")
}

model ProductVariant {
  id                       String                    @id @default(cuid())
  productId                String
  sku                      String                    @unique
  size                     String?
  color                    String?
  colorHex                 String?
  images                   String?
  price                    Float?
  inventory                Int                       @default(0)
  isActive                 Boolean                   @default(true)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  costPrice                Float?
  backInStockNotifications BackInStockNotification[]
  cartItems                CartItem[]
  cartReservations         CartReservation[]
  orderItems               OrderItem[]
  product                  Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  wishlistItems            WishlistItem[]

  @@map("product_variants")
}

model Customer {
  id                       String                    @id @default(cuid())
  email                    String                    @unique
  password                 String?
  name                     String?
  phone                    String?
  isAdmin                  Boolean                   @default(false)
  birthday                 DateTime?
  newsletter               Boolean                   @default(false)
  smsOptIn                 Boolean                   @default(false)
  totalSpent               Float                     @default(0)
  totalOrders              Int                       @default(0)
  lastOrderDate            DateTime?
  avgOrderValue            Float                     @default(0)
  loyaltyTierId            String?
  currentPoints            Int                       @default(0)
  lifetimePoints           Int                       @default(0)
  annualSpend              Float                     @default(0)
  tierStartDate            DateTime                  @default(now())
  referredBy               String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  annualPointsEarned       Int                       @default(0)
  abandonedCarts           AbandonedCart[]
  accounts                 Account[]
  addresses                Address[]
  aiConversations          AiConversation[]
  backInStockNotifications BackInStockNotification[]
  cartItems                CartItem[]
  notes                    CustomerNote[]
  notifications            CustomerNotification[]
  loyaltyTier              LoyaltyTier?              @relation(fields: [loyaltyTierId], references: [id])
  giftCardTransactions     GiftCardTransaction[]
  purchasedGiftCards       GiftCard[]                @relation("GiftCardPurchaser")
  redeemedGiftCards        GiftCard[]                @relation("GiftCardRedeemer")
  liveChatSessions         LiveChatSession[]
  notificationPreferences  NotificationPreference?
  orders                   Order[]
  pointsTransactions       PointsTransaction[]
  productViews             ProductView[]
  referralCode             ReferralCode?
  reviews                  Review[]
  redemptions              RewardRedemption[]
  sessions                 Session[]
  supportTickets           SupportTicket[]
  avatarItems              UserAvatarItem[]
  avatar                   UserAvatar?
  wishlistItems            WishlistItem[]

  @@map("customers")
}

model CustomerNotification {
  id         String           @id @default(cuid())
  customerId String
  type       NotificationType
  title      String
  message    String
  linkUrl    String?
  linkLabel  String?
  metadata   String?
  isRead     Boolean          @default(false)
  readAt     DateTime?
  emailSent  Boolean          @default(false)
  pushSent   Boolean          @default(false)
  createdAt  DateTime         @default(now())
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, isRead])
  @@index([customerId, createdAt])
  @@index([type])
  @@map("customer_notifications")
}

model NotificationPreference {
  id                   String   @id @default(cuid())
  customerId           String   @unique
  inAppPointsEarned    Boolean  @default(true)
  inAppTierUpdates     Boolean  @default(true)
  inAppOrderUpdates    Boolean  @default(true)
  inAppPromotions      Boolean  @default(true)
  inAppDropAlerts      Boolean  @default(true)
  inAppRewardReminders Boolean  @default(true)
  emailPointsEarned    Boolean  @default(false)
  emailTierUpdates     Boolean  @default(true)
  emailOrderUpdates    Boolean  @default(true)
  emailPromotions      Boolean  @default(true)
  emailDropAlerts      Boolean  @default(true)
  emailRewardReminders Boolean  @default(true)
  emailPointsExpiring  Boolean  @default(true)
  emailBirthdayBonus   Boolean  @default(true)
  smsOrderUpdates      Boolean  @default(true)
  smsDropAlerts        Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  customer             Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model NewsletterSubscriber {
  id                String    @id @default(cuid())
  email             String    @unique
  source            String?
  sourceDetails     String?
  isActive          Boolean   @default(true)
  isVerified        Boolean   @default(false)
  verifiedAt        DateTime?
  unsubscribedAt    DateTime?
  unsubscribeReason String?
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([email])
  @@index([isActive])
  @@map("newsletter_subscribers")
}

model Account {
  id                String   @id @default(cuid())
  userId            String   @map("customer_id")
  type              String
  provider          String
  providerAccountId String   @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              Customer @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("customer_id")
  expires      DateTime
  user         Customer @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model CustomerNote {
  id          String   @id @default(cuid())
  customerId  String
  content     String
  authorId    String
  authorName  String
  isImportant Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_notes")
}

model UserAvatar {
  id            String   @id @default(cuid())
  customerId    String   @unique
  configuration String
  skinTone      String   @default("#FFE0BD")
  bodyType      String   @default("default")
  gender        String   @default("male")
  faceFeatures  String   @default("{\"eyeShape\":\"round\",\"noseShape\":\"medium\",\"mouthShape\":\"smile\",\"eyebrowShape\":\"normal\"}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("user_avatars")
}

model AvatarItem {
  id           String           @id @default(cuid())
  name         String
  description  String?
  slot         AvatarSlot
  modelUrl     String
  thumbnailUrl String?
  productId    String?
  rarity       ItemRarity       @default(COMMON)
  isDefault    Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  product      Product?         @relation(fields: [productId], references: [id])
  unlockedBy   UserAvatarItem[]

  @@index([productId])
  @@map("avatar_items")
}

model UserAvatarItem {
  id           String     @id @default(cuid())
  customerId   String
  avatarItemId String
  unlockedVia  String?
  orderId      String?
  unlockedAt   DateTime   @default(now())
  avatarItem   AvatarItem @relation(fields: [avatarItemId], references: [id], onDelete: Cascade)
  customer     Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, avatarItemId])
  @@index([customerId])
  @@index([avatarItemId])
  @@map("user_avatar_items")
}

model Address {
  id             String      @id @default(cuid())
  customerId     String
  firstName      String
  lastName       String
  company        String?
  address1       String
  address2       String?
  city           String
  state          String
  postalCode     String
  country        String      @default("US")
  isDefault      Boolean     @default(false)
  type           AddressType @default(SHIPPING)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  customer       Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  billingOrders  Order[]     @relation("BillingAddress")
  shippingOrders Order[]     @relation("ShippingAddress")

  @@map("addresses")
}

model Order {
  id                    String                @id @default(cuid())
  orderNumber           String                @unique
  customerId            String?
  status                OrderStatus           @default(PENDING)
  subtotal              Float
  shipping              Float
  tax                   Float
  total                 Float
  customerEmail         String
  customerPhone         String?
  shippingAddressId     String
  billingAddressId      String
  paymentMethod         String?
  paymentStatus         PaymentStatus         @default(PENDING)
  shippingMethod        String?
  trackingNumber        String?
  trackingUrl           String?
  carrier               String?
  shippedAt             DateTime?
  estimatedDelivery     DateTime?
  deliveredAt           DateTime?
  notes                 String?
  internalNotes         String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  couponCode            String?
  discount              Float                 @default(0)
  redemptionId          String?
  stripePaymentIntentId String?
  stripeRefundId        String?
  recoveredFromCart     AbandonedCart?
  giftCardTransactions  GiftCardTransaction[]
  purchasedGiftCards    GiftCard[]            @relation("GiftCardPurchaseOrder")
  giftCardsApplied      OrderGiftCard[]
  items                 OrderItem[]
  billingAddress        Address               @relation("BillingAddress", fields: [billingAddressId], references: [id])
  customer              Customer?             @relation(fields: [customerId], references: [id])
  redemption            RewardRedemption?     @relation(fields: [redemptionId], references: [id])
  shippingAddress       Address               @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  pointsTransactions    PointsTransaction[]
  reviews               Review[]
  supportTickets        SupportTicket[]

  @@map("orders")
}

model OrderItem {
  id               String          @id @default(cuid())
  orderId          String
  productId        String
  productVariantId String?
  quantity         Int
  price            Float
  productName      String
  productImage     String?
  variantDetails   String?
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id])
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])

  @@map("order_items")
}

model CartItem {
  id               String          @id @default(cuid())
  customerId       String
  productId        String
  productVariantId String?
  quantity         Int
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  customer         Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])

  @@unique([customerId, productId, productVariantId])
  @@map("cart_items")
}

model AbandonedCart {
  id                  String    @id @default(cuid())
  customerId          String?
  customerEmail       String
  customerName        String?
  items               String
  totalValue          Float
  itemCount           Int
  recoveryEmailSent   Boolean   @default(false)
  recoveryEmailSentAt DateTime?
  recovered           Boolean   @default(false)
  recoveredAt         DateTime?
  recoveryOrderId     String?   @unique
  abandonedAt         DateTime  @default(now())
  expiresAt           DateTime
  discountCode        String?
  discountAmount      Float?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  customer            Customer? @relation(fields: [customerId], references: [id])
  recoveryOrder       Order?    @relation(fields: [recoveryOrderId], references: [id])

  @@index([customerId])
  @@index([customerEmail])
  @@index([abandonedAt])
  @@map("abandoned_carts")
}

model WishlistItem {
  id               String          @id @default(cuid())
  customerId       String?
  sessionId        String?
  productId        String
  productVariantId String?
  notes            String?
  priority         Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  customer         Customer?       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])

  @@unique([customerId, productId, productVariantId])
  @@unique([sessionId, productId, productVariantId])
  @@index([customerId])
  @@index([sessionId])
  @@map("wishlist_items")
}

model DropNotification {
  id         String    @id @default(cuid())
  email      String
  productId  String
  notified   Boolean   @default(false)
  notifiedAt DateTime?
  source     String?
  createdAt  DateTime  @default(now())
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([email, productId])
  @@index([productId, notified])
  @@map("drop_notifications")
}

model CartReservation {
  id               String          @id @default(cuid())
  sessionId        String
  productId        String
  productVariantId String?
  quantity         Int
  expiresAt        DateTime
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@index([productVariantId, isActive, expiresAt])
  @@index([sessionId])
  @@map("cart_reservations")
}

model Review {
  id                 String              @id @default(cuid())
  productId          String
  customerId         String?
  orderId            String?
  rating             Int
  title              String?
  comment            String
  images             String?
  customerName       String
  customerEmail      String
  status             ReviewStatus        @default(PENDING)
  isVerified         Boolean             @default(false)
  moderatedBy        String?
  moderatedAt        DateTime?
  rejectionReason    String?
  adminReply         String?
  adminReplyBy       String?
  adminReplyAt       DateTime?
  helpfulCount       Int                 @default(0)
  notHelpfulCount    Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  pointsTransactions PointsTransaction[]
  customer           Customer?           @relation(fields: [customerId], references: [id])
  order              Order?              @relation(fields: [orderId], references: [id])
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, status])
  @@index([customerId])
  @@map("reviews")
}

model ProductView {
  id         String    @id @default(cuid())
  productId  String
  customerId String?
  sessionId  String?
  viewedAt   DateTime  @default(now())
  duration   Int?
  source     String?
  userAgent  String?
  ipAddress  String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([customerId])
  @@index([sessionId])
  @@index([viewedAt])
  @@map("product_views")
}

model ProductRecommendation {
  id              String             @id @default(cuid())
  sourceProductId String
  targetProductId String
  type            RecommendationType
  score           Float              @default(0)
  impressions     Int                @default(0)
  clicks          Int                @default(0)
  conversions     Int                @default(0)
  revenue         Float              @default(0)
  reason          String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  sourceProduct   Product            @relation("SourceProduct", fields: [sourceProductId], references: [id], onDelete: Cascade)
  targetProduct   Product            @relation("TargetProduct", fields: [targetProductId], references: [id], onDelete: Cascade)

  @@unique([sourceProductId, targetProductId, type])
  @@index([sourceProductId, type])
  @@index([score])
  @@map("product_recommendations")
}

model BackInStockNotification {
  id         String            @id @default(cuid())
  productId  String
  variantId  String?
  email      String
  customerId String?
  status     BackInStockStatus @default(PENDING)
  notifiedAt DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  expiresAt  DateTime?
  customer   Customer?         @relation(fields: [customerId], references: [id])
  product    Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([productId, variantId, email])
  @@index([status])
  @@index([productId, status])
  @@index([variantId, status])
  @@index([customerId])
  @@map("back_in_stock_notifications")
}

model LoyaltySettings {
  id                       String   @id @default("default")
  isEnabled                Boolean  @default(true)
  programName              String   @default("Loyalty Rewards")
  pointsPerDollar          Int      @default(1)
  pointsRoundingMode       String   @default("round")
  minimumOrderForPoints    Float    @default(0)
  referralPointsReferrer   Int      @default(100)
  referralPointsReferred   Int      @default(50)
  referralEnabled          Boolean  @default(true)
  reviewPointsEnabled      Boolean  @default(true)
  reviewPointsAmount       Int      @default(25)
  reviewWithPhotoBonus     Int      @default(25)
  birthdayRewardsEnabled   Boolean  @default(true)
  birthdayRewardType       String   @default("points")
  birthdayRewardValue      Int      @default(100)
  birthdayRewardExpireDays Int      @default(30)
  pointsExpireEnabled      Boolean  @default(false)
  pointsExpireMonths       Int      @default(12)
  tierEvaluationPeriod     String   @default("annual")
  tierDowngradeEnabled     Boolean  @default(true)
  showPointsInCart         Boolean  @default(true)
  showPointsInCheckout     Boolean  @default(true)
  showTierProgress         Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@map("loyalty_settings")
}

model SalesGoals {
  id              String             @id @default("default")
  dailyTarget     Float              @default(500)
  weeklyTarget    Float              @default(3500)
  monthlyTarget   Float              @default(15000)
  quarterlyTarget Float              @default(45000)
  yearlyTarget    Float              @default(180000)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  goalsHistory    SalesGoalHistory[]

  @@map("sales_goals")
}

model SalesGoalHistory {
  id           String     @id @default(cuid())
  salesGoalsId String     @default("default")
  period       String
  periodStart  DateTime
  periodEnd    DateTime
  target       Float
  achieved     Float
  percentage   Float
  metGoal      Boolean
  createdAt    DateTime   @default(now())
  salesGoals   SalesGoals @relation(fields: [salesGoalsId], references: [id], onDelete: Cascade)

  @@index([period, periodStart])
  @@index([salesGoalsId])
  @@map("sales_goal_history")
}

model LoyaltyTier {
  id              String     @id @default(cuid())
  name            String     @unique
  slug            String     @unique
  description     String?
  minAnnualSpend  Float      @default(0)
  isInviteOnly    Boolean    @default(false)
  pointMultiplier Float      @default(1.0)
  freeShipping    Boolean    @default(false)
  earlyDropAccess Boolean    @default(false)
  perks           String?
  sortOrder       Int        @default(0)
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  minAnnualPoints Int        @default(0)
  customers       Customer[]

  @@map("loyalty_tiers")
}

model PointsTransaction {
  id           String                @id @default(cuid())
  customerId   String
  points       Int
  type         PointsTransactionType
  description  String
  orderId      String?
  reviewId     String?
  redemptionId String?
  referralId   String?
  expiresAt    DateTime?
  isExpired    Boolean               @default(false)
  metadata     String?
  createdAt    DateTime              @default(now())
  customer     Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order        Order?                @relation(fields: [orderId], references: [id])
  redemption   RewardRedemption?     @relation(fields: [redemptionId], references: [id])
  review       Review?               @relation(fields: [reviewId], references: [id])

  @@index([customerId])
  @@index([orderId])
  @@index([type])
  @@map("points_transactions")
}

model PointsMultiplierEvent {
  id                      String   @id @default(cuid())
  name                    String
  description             String?
  startDate               DateTime
  endDate                 DateTime
  multiplier              Float    @default(2.0)
  tierIds                 String?
  categoryIds             String?
  isActive                Boolean  @default(true)
  totalBonusPointsAwarded Int      @default(0)
  ordersAffected          Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([startDate, endDate])
  @@index([isActive])
  @@map("points_multiplier_events")
}

model Reward {
  id                        String             @id @default(cuid())
  name                      String
  slug                      String             @unique
  description               String?
  pointsCost                Int
  rewardType                RewardType
  value                     Float?
  isActive                  Boolean            @default(true)
  maxRedemptionsPerCustomer Int?
  totalAvailable            Int?
  totalRedeemed             Int                @default(0)
  minTierRequired           String?
  metadata                  String?
  image                     String?
  sortOrder                 Int                @default(0)
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  redemptions               RewardRedemption[]

  @@map("rewards")
}

model RewardRedemption {
  id                 String              @id @default(cuid())
  customerId         String
  rewardId           String
  pointsSpent        Int
  status             RedemptionStatus    @default(PENDING)
  couponCode         String?             @unique
  usedAt             DateTime?
  orderId            String?
  trackingNumber     String?
  shippedAt          DateTime?
  metadata           String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  idempotencyKey     String              @unique
  orders             Order[]
  pointsTransactions PointsTransaction[]
  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reward             Reward              @relation(fields: [rewardId], references: [id])

  @@index([customerId])
  @@index([rewardId])
  @@index([couponCode])
  @@map("reward_redemptions")
}

model ReferralCode {
  id         String   @id @default(cuid())
  customerId String   @unique
  code       String   @unique
  timesUsed  Int      @default(0)
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("referral_codes")
}

model SupportTicket {
  id              String              @id @default(cuid())
  ticketNumber    String              @unique
  type            SupportTicketType
  status          SupportTicketStatus @default(OPEN)
  priority        SupportPriority     @default(MEDIUM)
  subject         String
  customerId      String?
  customerEmail   String
  customerName    String
  orderId         String?
  orderNumber     String?
  refundAmount    Float?
  refundReason    String?
  returnRequested Boolean             @default(false)
  returnApproved  Boolean?
  returnLabel     String?
  assignedToId    String?
  assignedAt      DateTime?
  resolvedAt      DateTime?
  resolvedBy      String?
  resolution      String?
  aiAssisted      Boolean             @default(false)
  aiSummary       String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  liveChatSession LiveChatSession?
  messages        SupportMessage[]
  assignedTo      AdminUser?          @relation(fields: [assignedToId], references: [id])
  customer        Customer?           @relation(fields: [customerId], references: [id])
  order           Order?              @relation(fields: [orderId], references: [id])

  @@index([customerId])
  @@index([orderId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("support_tickets")
}

model SupportMessage {
  id          String        @id @default(cuid())
  ticketId    String
  message     String
  isInternal  Boolean       @default(false)
  senderType  String
  senderId    String?
  senderName  String
  attachments String?
  createdAt   DateTime      @default(now())
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([createdAt])
  @@map("support_messages")
}

model LiveChatSession {
  id             String            @id @default(cuid())
  sessionId      String            @unique
  ticketId       String            @unique
  customerId     String?
  adminId        String?
  status         ChatSessionStatus @default(WAITING)
  requestedAt    DateTime          @default(now())
  acceptedAt     DateTime?
  closedAt       DateTime?
  customerName   String
  customerEmail  String
  waitTime       Int?
  duration       Int?
  preChatContext String?
  issueCategory  String?
  issueSummary   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  messages       LiveChatMessage[]
  admin          AdminUser?        @relation(fields: [adminId], references: [id])
  customer       Customer?         @relation(fields: [customerId], references: [id])
  ticket         SupportTicket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([adminId])
  @@index([requestedAt])
  @@map("live_chat_sessions")
}

model LiveChatMessage {
  id         String          @id @default(cuid())
  sessionId  String
  message    String
  senderType String
  senderId   String?
  senderName String
  isRead     Boolean         @default(false)
  readAt     DateTime?
  createdAt  DateTime        @default(now())
  session    LiveChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@map("live_chat_messages")
}

model AdminAvailability {
  id          String    @id @default(cuid())
  adminId     String    @unique
  isOnline    Boolean   @default(false)
  status      String    @default("offline")
  maxChats    Int       @default(3)
  activeChats Int       @default(0)
  lastSeenAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  admin       AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("admin_availability")
}

model AiConversation {
  id             String            @id @default(cuid())
  title          String?
  customerId     String?
  adminId        String?
  isActive       Boolean           @default(true)
  messageCount   Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  admin          AdminUser?        @relation(fields: [adminId], references: [id], onDelete: Cascade)
  customer       Customer?         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages       AiMessage[]
  pendingActions AiPendingAction[]

  @@index([customerId])
  @@index([adminId])
  @@map("ai_conversations")
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           AiMessageRole
  content        String
  toolCalls      String?
  toolResults    String?
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

model AiPendingAction {
  id             String         @id @default(cuid())
  conversationId String
  actionType     String
  actionPayload  String
  description    String
  status         AiActionStatus @default(PENDING)
  executedAt     DateTime?
  result         String?
  expiresAt      DateTime
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([status])
  @@map("ai_pending_actions")
}

model ExpenseCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  color       String    @default("#6B7280")
  icon        String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  budgets     Budget[]
  expenses    Expense[]

  @@map("expense_categories")
}

model Expense {
  id                 String          @id @default(cuid())
  categoryId         String
  description        String
  amount             Float
  date               DateTime        @default(now())
  vendor             String?
  receiptUrl         String?
  notes              String?
  isTaxDeductible    Boolean         @default(false)
  taxCategory        String?
  paymentMethod      String?
  isRecurring        Boolean         @default(false)
  recurringFrequency String?
  status             ExpenseStatus   @default(RECORDED)
  invoiceId          String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  category           ExpenseCategory @relation(fields: [categoryId], references: [id])
  invoice            Invoice?        @relation(fields: [invoiceId], references: [id])

  @@index([categoryId])
  @@index([date])
  @@index([status])
  @@map("expenses")
}

model Invoice {
  id               String        @id @default(cuid())
  invoiceNumber    String        @unique
  vendorName       String
  vendorEmail      String?
  vendorAddress    String?
  description      String?
  subtotal         Float
  tax              Float         @default(0)
  total            Float
  issueDate        DateTime      @default(now())
  dueDate          DateTime
  paidDate         DateTime?
  status           InvoiceStatus @default(PENDING)
  paymentMethod    String?
  paymentReference String?
  documentUrl      String?
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  expenses         Expense[]

  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

model Budget {
  id                String           @id @default(cuid())
  categoryId        String?
  name              String
  amount            Float
  period            BudgetPeriod     @default(MONTHLY)
  startDate         DateTime
  endDate           DateTime
  warningThreshold  Float            @default(75)
  criticalThreshold Float            @default(90)
  isActive          Boolean          @default(true)
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  category          ExpenseCategory? @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([period])
  @@map("budgets")
}

model TaxRecord {
  id                    String          @id @default(cuid())
  period                TaxPeriod
  year                  Int
  quarter               Int?
  month                 Int?
  grossRevenue          Float           @default(0)
  taxableRevenue        Float           @default(0)
  salesTaxCollected     Float           @default(0)
  totalExpenses         Float           @default(0)
  deductibleExpenses    Float           @default(0)
  netIncome             Float           @default(0)
  estimatedTaxLiability Float           @default(0)
  taxPaid               Float           @default(0)
  paidDate              DateTime?
  paymentReference      String?
  status                TaxRecordStatus @default(DRAFT)
  notes                 String?
  documentUrls          String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@unique([period, year, quarter, month])
  @@index([year])
  @@index([status])
  @@map("tax_records")
}

model FinancialSnapshot {
  id                String   @id @default(cuid())
  date              DateTime @default(now())
  periodType        String   @default("daily")
  totalRevenue      Float    @default(0)
  totalOrders       Int      @default(0)
  avgOrderValue     Float    @default(0)
  totalCOGS         Float    @default(0)
  totalExpenses     Float    @default(0)
  grossProfit       Float    @default(0)
  grossMargin       Float    @default(0)
  netProfit         Float    @default(0)
  netMargin         Float    @default(0)
  salesTaxCollected Float    @default(0)
  inventoryValue    Float    @default(0)
  cashOnHand        Float?
  createdAt         DateTime @default(now())

  @@unique([date, periodType])
  @@index([date])
  @@map("financial_snapshots")
}

model Promotion {
  id                 String           @id @default(cuid())
  name               String
  description        String?
  type               PromotionType    @default(PERCENTAGE)
  value              Float
  code               String?          @unique
  autoApply          Boolean          @default(false)
  minimumPurchase    Float?
  maxUsesTotal       Int?
  maxUsesPerCustomer Int?
  usedCount          Int              @default(0)
  productIds         String?
  collectionIds      String?
  customerEmails     String?
  startDate          DateTime         @default(now())
  endDate            DateTime?
  isActive           Boolean          @default(true)
  stackable          Boolean          @default(false)
  maxDiscountPercent Float?
  excludeFromLoyalty Boolean          @default(false)
  totalDiscountGiven Float            @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  popups             MarketingPopup[]

  @@index([code])
  @@index([isActive, startDate, endDate])
  @@map("promotions")
}

model MarketingPopup {
  id                String           @id @default(cuid())
  name              String
  template          PopupTemplate    @default(MODAL)
  position          PopupPosition    @default(CENTER)
  content           String
  triggerType       PopupTrigger     @default(DELAY)
  triggerValue      Int              @default(3)
  showOnPages       String           @default("all")
  showToNewVisitors Boolean          @default(true)
  showToReturning   Boolean          @default(true)
  frequency         PopupFrequency   @default(ONCE_PER_SESSION)
  startDate         DateTime?
  endDate           DateTime?
  isActive          Boolean          @default(true)
  priority          Int              @default(0)
  promotionId       String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  promotion         Promotion?       @relation(fields: [promotionId], references: [id])
  analytics         PopupAnalytics[]
  variants          PopupVariant[]

  @@index([isActive, startDate, endDate])
  @@index([promotionId])
  @@map("marketing_popups")
}

model PopupVariant {
  id        String           @id @default(cuid())
  popupId   String
  name      String
  content   String?
  weight    Int              @default(50)
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  analytics PopupAnalytics[]
  popup     MarketingPopup   @relation(fields: [popupId], references: [id], onDelete: Cascade)

  @@index([popupId])
  @@map("popup_variants")
}

model PopupAnalytics {
  id          String         @id @default(cuid())
  popupId     String
  variantId   String?
  date        DateTime       @default(now())
  impressions Int            @default(0)
  clicks      Int            @default(0)
  dismissals  Int            @default(0)
  conversions Int            @default(0)
  popup       MarketingPopup @relation(fields: [popupId], references: [id], onDelete: Cascade)
  variant     PopupVariant?  @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([popupId, variantId, date])
  @@index([popupId, date])
  @@map("popup_analytics")
}

model GiftCard {
  id              String                @id @default(cuid())
  code            String                @unique
  initialBalance  Float
  currentBalance  Float
  currency        String                @default("USD")
  status          GiftCardStatus        @default(ACTIVE)
  expiresAt       DateTime?
  purchasedById   String?
  purchaseOrderId String?
  recipientEmail  String?
  recipientName   String?
  senderName      String?
  personalMessage String?
  redeemedById    String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  transactions    GiftCardTransaction[]
  purchaseOrder   Order?                @relation("GiftCardPurchaseOrder", fields: [purchaseOrderId], references: [id])
  purchasedBy     Customer?             @relation("GiftCardPurchaser", fields: [purchasedById], references: [id])
  redeemedBy      Customer?             @relation("GiftCardRedeemer", fields: [redeemedById], references: [id])
  appliedToOrders OrderGiftCard[]

  @@index([code])
  @@index([status])
  @@index([purchasedById])
  @@index([redeemedById])
  @@map("gift_cards")
}

model GiftCardTransaction {
  id           String                  @id @default(cuid())
  giftCardId   String
  type         GiftCardTransactionType
  amount       Float
  balanceAfter Float
  orderId      String?
  description  String?
  customerId   String?
  createdAt    DateTime                @default(now())
  customer     Customer?               @relation(fields: [customerId], references: [id])
  giftCard     GiftCard                @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  order        Order?                  @relation(fields: [orderId], references: [id])

  @@index([giftCardId])
  @@index([orderId])
  @@map("gift_card_transactions")
}

model OrderGiftCard {
  id            String   @id @default(cuid())
  orderId       String
  giftCardId    String
  amountApplied Float
  createdAt     DateTime @default(now())
  giftCard      GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, giftCardId])
  @@index([orderId])
  @@index([giftCardId])
  @@map("order_gift_cards")
}

