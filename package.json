{
  "name": "head-over-feels",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:fresh": "npm run db:reset:dev && next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "postinstall": "prisma generate",
    "db:push:dev": "npx prisma db push",
    "db:seed:dev": "npx tsx scripts/seed-dev-data.ts",
    "db:reset:dev": "npm run db:push:dev && npm run db:seed:dev",
    "db:studio:dev": "npx prisma studio",
    "db:studio:prod": "cp .env.production .env && npx prisma studio",
    "env:dev": "cp .env.development .env && echo 'Switched to DEVELOPMENT environment'",
    "env:prod": "cp .env.production .env && echo 'Switched to PRODUCTION environment'"
  },
  "dependencies": {
