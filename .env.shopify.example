# Shopify credentials for the headless storefront.
# Copy to .env.shopify (git-ignored) and fill in. Never commit real tokens.

# myshopify.com domain of the store (no protocol, no trailing slash)
SHOPIFY_STORE_DOMAIN=

# Storefront API version to pin requests to; defaults to 2026-07 when unset
SHOPIFY_STOREFRONT_API_VERSION=

# Headless channel private Storefront access token — server only, never sent to the browser
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Headless channel public Storefront access token — Shop Pay button + predictive search only
NEXT_PUBLIC_SHOPIFY_STOREFRONT_PUBLIC_TOKEN=

# Admin API access token from the "HOF Ops" custom app — migration scripts + discount codes
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Shared secret used to verify HMAC signatures on inbound Shopify webhooks
SHOPIFY_WEBHOOK_SECRET=

# Customer Account API (Phase 4) — Headless storefront > Customer Account API client.
# Client id of the public (PKCE) client; the hosted login + /account/* need it.
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=

# Shop id shown next to the client id (this store: 85215183073)
SHOPIFY_CUSTOMER_ACCOUNT_SHOP_ID=

# Storefront origin registered as the OAuth callback / JavaScript origin, no trailing slash
# (preview: the Vercel preview URL; production: the primary domain). Shopify refuses http:// and localhost.
NEXT_PUBLIC_BASE_URL=

# Secret the hof_customer session cookie is encrypted with (AES-256-GCM key = SHA-256 of this value).
# Falls back to AUTH_SECRET when unset. Any long random string; rotating it signs every customer out.
CUSTOMER_SESSION_SECRET=

# Test only: overrides OIDC + Customer Account API discovery (defaults to https://$SHOPIFY_STORE_DOMAIN).
# The Playwright suite points it at the mock, e.g. http://127.0.0.1:4443/customer. Leave empty in real envs.
SHOPIFY_CUSTOMER_ACCOUNT_ISSUER=

# Free shipping threshold in store currency, surfaced in the cart/announcement bar
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=75
